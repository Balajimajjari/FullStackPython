# operators in python

# Arithmetic operators
a=100
b=10
print(a+b)
print(a-b)
print(a*b)
print(a/b)
print(a//b)
print(a%b)
print(a**b)

#Assignment operators
#=,+=,-=,*=,/=,//=,%=,**=

a=100
a=a+50
print(a)

a+=200
print(a)

a-=250
print(a)

a*=5
print(a)

a/=5
print(a)

#comparision operator
#==,!=,>,<,>=,<=
a=100
b=50
print(a==b)
print(a!=b)
c=a>b
print(c)
print(a<b)
print(a>=b)
print(a<=b)


#Logical operators
# #and,or,not
a=300
b=200
c=100
print(a>b and a>c)
print(a>b and a<b)
print(a>b or a>c)
print(a<b or a<c)
print(not(a>b))


#Bitwise operators
#&,|,^,~,<<,>>
a=18
b=15
print(a&b)
print(a|b)
print(a^b)
print(~a)
print(a<<3)
print(a>>3)

#membership operators
#in,not in
a=(1,2,3,4)
print(1 in a)
print(5 in a)
print(2 not in a)

#identity operator
#is, is not
a=10
print(a,id(a))
b=10
print(b,id(b))
print(a is b)
